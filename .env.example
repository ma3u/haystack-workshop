# Haystack Workshop Environment Variables
# Copy to .env and fill in your values

# LLM provider: Azure OpenAI (AI Foundry) is used when AZURE_OPENAI_ENDPOINT is set,
# otherwise OpenAI. See exercises/llm.py.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_key_here
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# OpenAI API (fallback)
OPENAI_API_KEY=your_key_here

# Anthropic API (alternative LLM)
ANTHROPIC_API_KEY=your_key_here

# Vector DB connections
QDRANT_URL=http://localhost:6333
WEAVIATE_URL=http://localhost:8080

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Workshop settings
DEBUG=False
LOG_LEVEL=INFO

# Neo4j (Challenge F, exercises/neo4j_document_store.py)
# Use 127.0.0.1, not localhost: localhost may resolve to ::1 and hit another service.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# Neo4j Aura Cloud (Challenge G, exercises/12_enterprise_aura_bundle.py)
NEO4J_AURA_URI=neo4j+s://<custom-or-instance-id>.endpoints.neo4j.io
NEO4J_AURA_ENDPOINT=neo4j+s://<custom-or-instance-id>.endpoints.neo4j.io
NEO4J_AURA_USER=neo4j
NEO4J_AURA_PASSWORD=your_aura_password_here

# Google Gemini API (alternative LLM): set LLM_PROVIDER=gemini to use it. Key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
